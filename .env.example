# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host-pooler.c-5.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Google Gemini AI
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.6-flash"

# Discord Bot & Channels
DISCORD_BOT_TOKEN="your-discord-bot-token"
DISCORD_PENDING_CHANNEL_ID="your-channel-id"
DISCORD_APPROVED_CHANNEL_ID="your-channel-id"
DISCORD_REJECTED_CHANNEL_ID="your-channel-id"
DISCORD_LOG_CHANNELS="id1,id2,id3"

# Gmail CV Inbox Polling
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-app-password"
CV_INBOX_POLL_INTERVAL_MS=30000

# WhatsApp Configuration
WHATSAPP_SESSION_PATH="./whatsapp_auth"
WHATSAPP_AUTO_DISMISS_POPUPS=true

# Scraper Interval
SCRAPER_CRON="0 */3 * * *"
